<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Revit-Excel Link - add-in core, built once per supported Revit version (-p:RevitVersion=...):
      2024 -> net48           (Revit 2024 hosts .NET Framework 4.8; loaded directly)
      2025 -> net8.0-windows  (loaded through RevitScheduleSync.Loader into a private AssemblyLoadContext,
                               because Revit 2025 has no add-in isolation)
      2026 -> net8.0-windows  (loaded directly, isolated by Revit via UseRevitContext=False;
                               also runs on Revit 2026 updates that host .NET 10)
      2027 -> net10.0-windows (loaded directly, isolated by Revit via UseRevitContext=False)
    Revit API assemblies come from the Nice3point.Revit.Api reference packages, so no Revit install is
    needed to build (CI included). x64 only.
  -->
  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RevitScheduleSync</RootNamespace>
    <AssemblyName>RevitScheduleSync</AssemblyName>

    <Version>1.2.0</Version>
    <!-- Build date and time in the product version (window footer, ribbon tooltip, file properties),
         so the newest installed build is obvious. The SDK appends "+<commit>" after it. -->
    <BuildStamp>$([System.DateTime]::Now.ToString('yyyy-MM-dd HH:mm'))</BuildStamp>
    <InformationalVersion>$(Version) build $(BuildStamp)</InformationalVersion>
    <Product>Revit-Excel Link</Product>
    <Company>Revit-Excel Link</Company>

    <!-- Plugin-style output: copy NuGet dependencies next to the add-in DLL and emit a .deps.json
         so the add-in load context (Revit 2026/2027, or our loader in 2025) can resolve ClosedXML and its dependencies. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- MSB3277: Revit's own internal assemblies (pulled in through RevitAPIUI.dll) reference older
         System.Drawing / Microsoft.VisualBasic facade versions. Revit supplies them at runtime and
         they are never copied, so the version conflict is harmless for this add-in. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>

    <!-- Copy the build output into the per-user Revit add-ins folder after each Debug build.
         Disable with: dotnet build -p:DeployToRevit=false -->
    <DeployToRevit Condition="'$(DeployToRevit)' == '' and '$(Configuration)' == 'Debug'">true</DeployToRevit>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RevitVersion)' == '2024'">
    <TargetFramework>net48</TargetFramework>
    <!-- .NET Framework APIs (Path, File, ...) carry no nullable annotations; these warnings are noise there. -->
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604</NoWarn>
    <RevitApiPackageVersion>2024.0.0</RevitApiPackageVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RevitVersion)' == '2025'">
    <TargetFramework>net8.0-windows</TargetFramework>
    <RevitApiPackageVersion>2025.4.60</RevitApiPackageVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RevitVersion)' == '2026'">
    <TargetFramework>net8.0-windows</TargetFramework>
    <RevitApiPackageVersion>2026.0.4</RevitApiPackageVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RevitVersion)' == '2027'">
    <TargetFramework>net10.0-windows</TargetFramework>
    <RevitApiPackageVersion>2027.0.0</RevitApiPackageVersion>
  </PropertyGroup>
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
    <RevitAddinsDir>$(APPDATA)\Autodesk\Revit\Addins\$(RevitVersion)\</RevitAddinsDir>
  </PropertyGroup>

  <Target Name="CheckRevitVersion" BeforeTargets="Restore;CollectPackageReferences;Build">
    <Error Condition="'$(RevitApiPackageVersion)' == ''"
           Text="Unsupported RevitVersion '$(RevitVersion)'. Use 2024, 2025, 2026 or 2027." />
  </Target>

  <ItemGroup>
    <!-- Revit API assemblies are supplied by Revit at runtime: compile against them only, never copy them. -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitApiPackageVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitApiPackageVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- Built into .NET 8+; needed on .NET Framework (Revit 2024) for profile files. -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <!-- Development manifests: Revit 2026/2027 (isolated) and Revit 2024 (no isolation setting).
       Revit 2025 uses the loader's manifest. -->
  <ItemGroup>
    <None Remove="RevitScheduleSync.addin;RevitScheduleSync2024.addin" />
    <None Include="RevitScheduleSync.addin" Condition="'$(RevitVersion)' == '2026' or '$(RevitVersion)' == '2027'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="RevitScheduleSync2024.addin" Condition="'$(RevitVersion)' == '2024'">
      <Link>RevitScheduleSync.addin</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    Deploy layout:
      Revit 2024/2026/2027: Addins\<year>\RevitScheduleSync.addin + Addins\<year>\RevitScheduleSync\RevitScheduleSync.dll (+ dependencies)
      Revit 2025: Addins\2025\RevitScheduleSync\core\RevitScheduleSync.dll (+ dependencies);
                  the manifest and loader DLL are deployed by RevitScheduleSync.Loader.
    Fails with a warning (not an error) when Revit is running and holds the DLL open.
  -->
  <Target Name="DeployToRevitAddins" AfterTargets="Build" Condition="'$(DeployToRevit)' == 'true' and '$(TargetFramework)' != ''">
    <PropertyGroup>
      <_DeployFolder>$(RevitAddinsDir)RevitScheduleSync\</_DeployFolder>
      <_DeployFolder Condition="'$(RevitVersion)' == '2025'">$(RevitAddinsDir)RevitScheduleSync\core\</_DeployFolder>
    </PropertyGroup>
    <ItemGroup>
      <_DeployFiles Include="$(OutDir)**\*" Exclude="$(OutDir)**\*.addin;$(OutDir)**\*.pdb.tmp" />
    </ItemGroup>
    <Copy SourceFiles="@(_DeployFiles)"
          DestinationFolder="$(_DeployFolder)%(RecursiveDir)"
          SkipUnchangedFiles="true"
          Retries="0"
          ContinueOnError="WarnAndContinue" />
    <PropertyGroup>
      <_DeployFilesOk>$(MSBuildLastTaskResult)</_DeployFilesOk>
      <_DeployManifestOk>true</_DeployManifestOk>
    </PropertyGroup>
    <Copy Condition="'$(RevitVersion)' != '2025'"
          SourceFiles="$(OutDir)RevitScheduleSync.addin"
          DestinationFolder="$(RevitAddinsDir)"
          SkipUnchangedFiles="true"
          Retries="0"
          ContinueOnError="WarnAndContinue" />
    <PropertyGroup Condition="'$(RevitVersion)' != '2025'">
      <_DeployManifestOk>$(MSBuildLastTaskResult)</_DeployManifestOk>
    </PropertyGroup>
    <Message Condition="'$(_DeployFilesOk)' == 'true' and '$(_DeployManifestOk)' == 'true'"
             Importance="high" Text="Deployed Revit-Excel Link $(RevitVersion) to $(_DeployFolder)" />
    <Warning Condition="'$(_DeployFilesOk)' != 'true' or '$(_DeployManifestOk)' != 'true'"
             Text="Revit-Excel Link $(RevitVersion) was NOT deployed: the add-in files are in use (is Revit running?). Close Revit and build again." />
  </Target>

</Project>
