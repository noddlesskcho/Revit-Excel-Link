<UserControl x:Class="RevitScheduleSync.UI.Views.ChangeReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Theme merged locally: see ScheduleSelectionView.xaml for why. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- Summary card as a flat button: clicking it filters the grid. -->
            <Style x:Key="CardButton" TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Command" Value="{Binding DataContext.ShowFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                                    BorderThickness="1" CornerRadius="4" Padding="12,8" MinWidth="104">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title + steps -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding FileName}" Style="{StaticResource Text.Title}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding ExportedText}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,2,0,0">
                <Border Style="{StaticResource StepPill.Done}">
                    <TextBlock Text="&#x2713;  Select" FontSize="12" />
                </Border>
                <TextBlock Text="&#x203A;" Margin="6,0" FontSize="16" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}" />
                <Border Style="{StaticResource StepPill.Current}">
                    <TextBlock Text="2  Review" FontSize="12" />
                </Border>
                <TextBlock Text="&#x203A;" Margin="6,0" FontSize="16" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}" />
                <Border Style="{StaticResource StepPill.Upcoming}">
                    <TextBlock Text="3  Apply" FontSize="12" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Project check -->
        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource ErrorBox}" Margin="0,0,0,10"
                    Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Wrong project — import blocked" FontWeight="SemiBold" Foreground="#8A2A2A" />
                    <TextBlock Text="{Binding FingerprintText}" Style="{StaticResource Text.Body}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource NoteBox}" Margin="0,0,0,10"
                    Visibility="{Binding IsUncertain, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding FingerprintText}" Style="{StaticResource Text.Body}" />
            </Border>
        </StackPanel>

        <!-- Summary cards (click to filter) -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,8">
            <Button Style="{StaticResource CardButton}" CommandParameter="Changes">
                <StackPanel>
                    <TextBlock Text="{Binding ChangeCount}" Style="{StaticResource Text.CardNumber}" Foreground="#1E6B34" />
                    <TextBlock Text="Changes" Style="{StaticResource Text.Muted}" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource CardButton}" CommandParameter="Type changes">
                <StackPanel>
                    <TextBlock Text="{Binding TypeChangeCount}" Style="{StaticResource Text.CardNumber}" Foreground="#1D4F91" />
                    <TextBlock Text="Type changes" Style="{StaticResource Text.Muted}" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource CardButton}" CommandParameter="Conflicts">
                <StackPanel>
                    <TextBlock Text="{Binding ConflictCount}" Style="{StaticResource Text.CardNumber}" Foreground="#8A2A2A" />
                    <TextBlock Text="Conflicts" Style="{StaticResource Text.Muted}" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource CardButton}" CommandParameter="Warnings">
                <StackPanel>
                    <TextBlock Text="{Binding WarningCount}" Style="{StaticResource Text.CardNumber}" Foreground="#7A5200" />
                    <TextBlock Text="Warnings" Style="{StaticResource Text.Muted}" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource CardButton}" CommandParameter="Blocked">
                <StackPanel>
                    <TextBlock Text="{Binding BlockedCount}" Style="{StaticResource Text.CardNumber}" Foreground="#8A2A2A" />
                    <TextBlock Text="Blocked" Style="{StaticResource Text.Muted}" />
                </StackPanel>
            </Button>
            <Border Width="1" Background="{StaticResource Brush.Border}" Margin="4,4,12,4" />
            <Button Style="{StaticResource CardButton}" CommandParameter="Needs decision">
                <StackPanel>
                    <TextBlock Text="{Binding PendingCount}" Style="{StaticResource Text.CardNumber}" />
                    <TextBlock Text="Need a decision" Style="{StaticResource Text.Muted}" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource CardButton}" CommandParameter="Will be applied">
                <StackPanel>
                    <TextBlock Text="{Binding WillWriteCount}" Style="{StaticResource Text.CardNumber}" Foreground="{StaticResource Brush.Accent}" />
                    <TextBlock Text="Will be applied" Style="{StaticResource Text.Muted}" />
                </StackPanel>
            </Button>
        </WrapPanel>

        <!-- Issues, filter, bulk actions -->
        <StackPanel Grid.Row="3">
            <Border Style="{StaticResource NoteBox}" Margin="0,0,0,8"
                    Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Issues}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource Text.Body}" Margin="0,1">
                                <Run Text="{Binding Severity, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Message, Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <!-- One tab per schedule (sheet); scopes the grid, cards and bulk actions. -->
            <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Margin="0,0,0,8">
                <ListBox ItemsSource="{Binding ScheduleTabs}" SelectedItem="{Binding SelectedTab}"
                         ItemContainerStyle="{StaticResource NavItem}" DisplayMemberPath="Label"
                         Background="Transparent" BorderThickness="0" Margin="-14,0,0,0"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </Border>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" DisplayMemberPath="Name"
                          Width="210" FontSize="12" />
                <TextBlock Grid.Column="1" Text="{Binding VisibleText}" Style="{StaticResource Text.Muted}"
                           VerticalAlignment="Center" Margin="10,0,0,0" />
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Content="Apply all changes" Style="{StaticResource Button.Link}" Command="{Binding ApplyAllChangesCommand}"
                            ToolTip="Set every simple (instance) change to Apply." />
                    <Button Content="Skip all changes" Style="{StaticResource Button.Link}" Command="{Binding SkipAllChangesCommand}" Margin="6,0,0,0" />
                    <Button Content="Approve type changes…" Style="{StaticResource Button.Link}" Command="{Binding ApproveTypeChangesCommand}"
                            Margin="6,0,0,0" ToolTip="Shows every type change and its affected instances before approving." />
                    <Button Content="Keep Revit for conflicts" Style="{StaticResource Button.Link}" Command="{Binding KeepRevitForConflictsCommand}"
                            Margin="6,0,0,0" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Change set -->
        <DataGrid Grid.Row="4" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedRow}"
                  Style="{StaticResource Grid.Flat}"
                  ColumnHeaderStyle="{StaticResource Grid.Header}"
                  CellStyle="{StaticResource Grid.Cell}">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NeedsDecision}" Value="True">
                            <Setter Property="Background" Value="#FFFBF0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Status" SortMemberPath="Status" Width="Auto" MinWidth="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ChangeBadge}">
                                <TextBlock Text="{Binding StatusText}" FontSize="11" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Schedule" Binding="{Binding Schedule}" Width="*" MinWidth="90" />
                <DataGridTextColumn Header="Element" Binding="{Binding Element}" Width="*" MinWidth="100" />
                <DataGridTextColumn Header="Element ID" Binding="{Binding ElementId}" Width="Auto" MinWidth="86" />
                <DataGridTextColumn Header="Parameter" Binding="{Binding Parameter}" Width="*" MinWidth="90" />
                <DataGridTextColumn Header="Parameter Type" Binding="{Binding Scope}" Width="Auto" MinWidth="70" />
                <DataGridTextColumn Header="Original" Binding="{Binding Original}" Width="*" MinWidth="70" />
                <DataGridTextColumn Header="Current Revit" Binding="{Binding Current}" Width="*" MinWidth="80" />
                <DataGridTextColumn Header="Excel" Binding="{Binding Excel}" Width="*" MinWidth="70">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Action" Width="185" SortMemberPath="Item.Decision">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <ComboBox ItemsSource="{Binding Actions}" SelectedItem="{Binding SelectedAction, Mode=TwoWay}"
                                          DisplayMemberPath="Text" FontSize="11" Height="22" VerticalContentAlignment="Center"
                                          Visibility="{Binding HasActions, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="—" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasActions}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Details of the selected row -->
        <Border Grid.Row="5" Style="{StaticResource Card}" Padding="12,8" Margin="0,8,0,0" MinHeight="54">
            <Grid>
                <TextBlock Text="{Binding SelectedRow.DetailText}" Style="{StaticResource Text.Body}" />
                <TextBlock Text="Select a row to see its details.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedRow}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Navigation -->
        <Grid Grid.Row="6" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="‹ Back" Style="{StaticResource Button.Secondary}" Command="{Binding BackCommand}" />
            <Button Grid.Column="1" Content="Re-analyse" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0"
                    Command="{Binding ReanalyseCommand}" ToolTip="Read the workbook again (after saving edits in Excel). Decisions are reset." />
            <TextBlock Grid.Column="2" Margin="12,0" VerticalAlignment="Center" Style="{StaticResource Text.Muted}" TextWrapping="Wrap"
                       Text="{Binding InfoText}" />
            <Button Grid.Column="3" Content="{Binding ApplyText}" Style="{StaticResource Button.Primary}"
                    Command="{Binding ApplyCommand}" ToolTipService.ShowOnDisabled="True"
                    ToolTip="Writes the approved values in one step (one Undo). You confirm first." />
        </Grid>
    </Grid>
</UserControl>
