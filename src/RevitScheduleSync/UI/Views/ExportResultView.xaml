<UserControl x:Class="RevitScheduleSync.UI.Views.ExportResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Theme merged locally: see ScheduleSelectionView.xaml for why. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Export complete" Style="{StaticResource Text.Title}" />
                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,2,0,0">
                <Border Style="{StaticResource StepPill.Done}">
                    <TextBlock Text="&#x2713;  Select" FontSize="12" />
                </Border>
                <TextBlock Text="&#x203A;" Margin="6,0" FontSize="16" VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.TextMuted}" />
                <Border Style="{StaticResource StepPill.Done}">
                    <TextBlock Text="&#x2713;  Analyse" FontSize="12" />
                </Border>
                <TextBlock Text="&#x203A;" Margin="6,0" FontSize="16" VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.TextMuted}" />
                <Border Style="{StaticResource StepPill.Current}">
                    <TextBlock Text="&#x2713;  Export" FontSize="12" />
                </Border>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding FileName}" Style="{StaticResource Text.Heading}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding FolderPath}" Style="{StaticResource Text.Muted}" TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" ToolTip="{Binding Result.FilePath}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button Content="Open folder" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"
                                    Command="{Binding OpenFolderCommand}" />
                            <Button Content="Open workbook" Style="{StaticResource Button.Primary}"
                                    Command="{Binding OpenFileCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource NoteBox}" Margin="0,12,0,0"
                        Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Notes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource Text.Body}" Margin="0,1">
                                    <Run Text="•  " /><Run Text="{Binding Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Before editing" Style="{StaticResource Text.Heading}" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource Text.Body}" Margin="0,1"
                                   Text="•  Edit white cells (instance) and blue cells (type: one change affects every element of that type)." />
                        <TextBlock Style="{StaticResource Text.Body}" Margin="0,1"
                                   Text="•  Do not rename sheets, delete rows, or remove the hidden first column." />
                        <TextBlock Style="{StaticResource Text.Body}" Margin="0,1"
                                   Text="•  Nothing has been written to the Revit model. Import with review arrives in a later phase." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="‹ Back to analysis" Style="{StaticResource Button.Secondary}" Command="{Binding BackCommand}" />
            <Button Grid.Column="2" Content="New export" Style="{StaticResource Button.Secondary}" Command="{Binding StartOverCommand}" />
        </Grid>
    </Grid>
</UserControl>
