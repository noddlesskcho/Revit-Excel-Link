<UserControl x:Class="RevitScheduleSync.UI.Views.ExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Theme merged here too: Revit has no WPF Application resources to fall back on, and
         StaticResource lookups run while this control loads, before it joins the window's tree. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title + step indicator -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Select schedules" Style="{StaticResource Text.Title}" />
                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,2,0,0"
                           Text="Itemised schedules support editable round-trip. Grouped schedules export for presentation only." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,2,0,0">
                <Border Style="{StaticResource StepPill.Current}">
                    <TextBlock Text="1  Select" FontSize="12" />
                </Border>
                <TextBlock Text="&#x203A;" Margin="6,0" FontSize="16" VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.TextMuted}" />
                <Border Style="{StaticResource StepPill.Upcoming}">
                    <TextBlock Text="2  Analyse" FontSize="12" />
                </Border>
                <TextBlock Text="&#x203A;" Margin="6,0" FontSize="16" VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.TextMuted}" />
                <Border Style="{StaticResource StepPill.Upcoming}">
                    <TextBlock Text="3  Export" FontSize="12" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Toolbar: search, bulk selection, unsupported toggle -->
        <Grid Grid.Row="1" Margin="0,14,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid>
                <TextBox x:Name="SearchInput" Style="{StaticResource SearchBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                <TextBlock Text="Search name, category or type" IsHitTestVisible="False"
                           Margin="9,0,0,0" VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource Brush.TextMuted}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Content="&#x2715;" HorizontalAlignment="Right" Margin="0,0,2,0"
                        ToolTip="Clear search" Command="{Binding ClearSearchCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Button.Link}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <Button Grid.Column="1" Content="Select all" Margin="8,0,0,0"
                    Style="{StaticResource Button.Secondary}" Command="{Binding SelectAllCommand}"
                    ToolTip="Select every supported schedule currently shown" />
            <Button Grid.Column="2" Content="Clear all" Margin="6,0,0,0"
                    Style="{StaticResource Button.Secondary}" Command="{Binding ClearAllCommand}" />

            <CheckBox Grid.Column="4" VerticalAlignment="Center" FontSize="12"
                      IsChecked="{Binding ShowUnsupported}"
                      Foreground="{StaticResource Brush.TextMuted}">
                <TextBlock>
                    <Run Text="Show unsupported (" /><Run Text="{Binding UnsupportedCount, Mode=OneWay}" /><Run Text=")" />
                </TextBlock>
            </CheckBox>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding ListSummaryText}" Style="{StaticResource Text.Muted}" Margin="0,0,0,6" />

        <!-- Schedule list -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding Schedules}"
                  Style="{StaticResource Grid.Flat}"
                  ColumnHeaderStyle="{StaticResource Grid.Header}"
                  CellStyle="{StaticResource Grid.Cell}">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelectable}" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="36" SortMemberPath="IsSelected" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding IsSelectable}"
                                      ToolTip="{Binding SupportDetail}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Schedule" Binding="{Binding Name}" Width="2*" MinWidth="160" />
                <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="*" MinWidth="100" />
                <DataGridTextColumn Header="Type" Binding="{Binding KindText}" Width="Auto" MinWidth="90" />
                <DataGridTextColumn Header="Layout" Binding="{Binding ModeText}" Width="Auto" MinWidth="70" />
                <DataGridTextColumn Header="Fields" Binding="{Binding FieldsText}" SortMemberPath="VisibleFieldCount"
                                    Width="105" />
                <DataGridTextColumn Header="Elements" Binding="{Binding ElementCountText}" SortMemberPath="ElementCountSortKey"
                                    Width="Auto" MinWidth="70">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Sync support" SortMemberPath="Support" Width="*" MinWidth="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SupportBadge}" ToolTip="{Binding SupportDetail}">
                                <TextBlock Text="{Binding SupportText}" FontSize="11" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="This project has no schedules that Schedule Sync can list."
                   Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

        <TextBlock Grid.Row="4" Text="{Binding ExcludedText}" Style="{StaticResource Text.Muted}"
                   FontSize="11" Margin="0,6,0,0" />

        <!-- Selection summary + next step -->
        <Grid Grid.Row="5" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding SelectionText}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
            <!-- ToolTipService.ShowOnDisabled: the tooltip explains why the button is disabled. -->
            <Button Grid.Column="1" Content="Analyse ›" Style="{StaticResource Button.Primary}"
                    Command="{Binding AnalyseCommand}"
                    ToolTipService.ShowOnDisabled="True"
                    ToolTip="Schedule analysis arrives in Phase 2." />
        </Grid>
    </Grid>
</UserControl>
