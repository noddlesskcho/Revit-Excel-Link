<UserControl x:Class="RevitScheduleSync.UI.Views.ImportAnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Theme merged locally: see ScheduleSelectionView.xaml for why. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title + steps -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding FileName}" Style="{StaticResource Text.Title}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding ExportedText}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,2,0,0">
                <Border Style="{StaticResource StepPill.Done}">
                    <TextBlock Text="&#x2713;  Select" FontSize="12" />
                </Border>
                <TextBlock Text="&#x203A;" Margin="6,0" FontSize="16" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}" />
                <Border Style="{StaticResource StepPill.Current}">
                    <TextBlock Text="2  Compare" FontSize="12" />
                </Border>
                <TextBlock Text="&#x203A;" Margin="6,0" FontSize="16" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}" />
                <Border Style="{StaticResource StepPill.Upcoming}">
                    <TextBlock Text="3  Apply" FontSize="12" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Project check -->
        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource ErrorBox}" Margin="0,0,0,10"
                    Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Wrong project — import blocked" FontWeight="SemiBold" Foreground="#8A2A2A" />
                    <TextBlock Text="{Binding FingerprintText}" Style="{StaticResource Text.Body}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource NoteBox}" Margin="0,0,0,10"
                    Visibility="{Binding IsUncertain, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding FingerprintText}" Style="{StaticResource Text.Body}" />
            </Border>
        </StackPanel>

        <!-- Summary cards -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,10">
            <Border Style="{StaticResource SummaryCard}">
                <StackPanel>
                    <TextBlock Text="{Binding ChangeCount}" Style="{StaticResource Text.CardNumber}" Foreground="#1E6B34" />
                    <TextBlock Text="Changes" Style="{StaticResource Text.Muted}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SummaryCard}">
                <StackPanel>
                    <TextBlock Text="{Binding TypeChangeCount}" Style="{StaticResource Text.CardNumber}" Foreground="#1D4F91" />
                    <TextBlock Text="Type changes" Style="{StaticResource Text.Muted}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SummaryCard}">
                <StackPanel>
                    <TextBlock Text="{Binding ConflictCount}" Style="{StaticResource Text.CardNumber}" Foreground="#8A2A2A" />
                    <TextBlock Text="Conflicts" Style="{StaticResource Text.Muted}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SummaryCard}">
                <StackPanel>
                    <TextBlock Text="{Binding WarningCount}" Style="{StaticResource Text.CardNumber}" Foreground="#7A5200" />
                    <TextBlock Text="Warnings" Style="{StaticResource Text.Muted}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SummaryCard}">
                <StackPanel>
                    <TextBlock Text="{Binding BlockedCount}" Style="{StaticResource Text.CardNumber}" Foreground="#8A2A2A" />
                    <TextBlock Text="Blocked" Style="{StaticResource Text.Muted}" />
                </StackPanel>
            </Border>
        </WrapPanel>

        <!-- Workbook issues + filters -->
        <StackPanel Grid.Row="3">
            <Border Style="{StaticResource NoteBox}" Margin="0,0,0,8"
                    Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Issues}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource Text.Body}" Margin="0,1">
                                <Run Text="{Binding Severity, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Message, Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" Width="180" FontSize="12" />
                <CheckBox Grid.Column="1" Content="Show unchanged values" IsChecked="{Binding ShowUnchanged}" FontSize="12"
                          VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBlock Grid.Column="2" Text="{Binding InfoText}" Style="{StaticResource Text.Muted}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </Grid>
        </StackPanel>

        <!-- Change set -->
        <DataGrid Grid.Row="4" ItemsSource="{Binding Items}"
                  Style="{StaticResource Grid.Flat}"
                  ColumnHeaderStyle="{StaticResource Grid.Header}"
                  CellStyle="{StaticResource Grid.Cell}">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="ToolTip" Value="{Binding Message}" />
                    <Setter Property="ToolTipService.InitialShowDelay" Value="500" />
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Status" SortMemberPath="Status" Width="Auto" MinWidth="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ChangeBadge}">
                                <TextBlock Text="{Binding StatusText}" FontSize="11" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Schedule" Binding="{Binding Schedule}" Width="*" MinWidth="100" />
                <DataGridTextColumn Header="Element" Binding="{Binding Element}" Width="*" MinWidth="110" />
                <DataGridTextColumn Header="Element ID" Binding="{Binding ElementId}" Width="Auto" MinWidth="86" />
                <DataGridTextColumn Header="Parameter" Binding="{Binding Parameter}" Width="*" MinWidth="90" />
                <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="Auto" MinWidth="60" />
                <DataGridTextColumn Header="Original" Binding="{Binding Original}" Width="*" MinWidth="80" />
                <DataGridTextColumn Header="Current Revit" Binding="{Binding Current}" Width="*" MinWidth="80" />
                <DataGridTextColumn Header="Excel" Binding="{Binding Excel}" Width="*" MinWidth="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Details" Binding="{Binding Message}" Width="2*" MinWidth="140">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Navigation -->
        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="‹ Back" Style="{StaticResource Button.Secondary}" Command="{Binding BackCommand}" />
            <Button Grid.Column="1" Content="Re-analyse" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0"
                    Command="{Binding ReanalyseCommand}" ToolTip="Read the workbook again (after saving edits in Excel)." />
            <TextBlock Grid.Column="2" Margin="12,0" VerticalAlignment="Center" Style="{StaticResource Text.Muted}"
                       Text="Nothing has been written to the model." />
            <Button Grid.Column="3" Content="Review &amp; apply ›" Style="{StaticResource Button.Primary}"
                    Command="{Binding ApplyCommand}" ToolTipService.ShowOnDisabled="True"
                    ToolTip="Review decisions arrive in Phase 6 and applying changes in Phase 7." />
        </Grid>
    </Grid>
</UserControl>
