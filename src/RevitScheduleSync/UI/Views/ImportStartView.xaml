<UserControl x:Class="RevitScheduleSync.UI.Views.ImportStartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Theme merged locally: see ScheduleSelectionView.xaml for why. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Import from Excel" Style="{StaticResource Text.Title}" />
                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,2,0,0"
                           Text="Choose a workbook exported by Schedule Sync. It is analysed and compared first; nothing is written to the model." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,2,0,0">
                <Border Style="{StaticResource StepPill.Current}">
                    <TextBlock Text="1  Select" FontSize="12" />
                </Border>
                <TextBlock Text="&#x203A;" Margin="6,0" FontSize="16" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}" />
                <Border Style="{StaticResource StepPill.Upcoming}">
                    <TextBlock Text="2  Compare" FontSize="12" />
                </Border>
                <TextBlock Text="&#x203A;" Margin="6,0" FontSize="16" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}" />
                <Border Style="{StaticResource StepPill.Upcoming}">
                    <TextBlock Text="3  Apply" FontSize="12" />
                </Border>
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Before you import" Style="{StaticResource Text.Heading}" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource Text.Body}" Margin="0,1"
                           Text="•  Save the workbook in Excel first. Unsaved edits are not visible to Schedule Sync." />
                <TextBlock Style="{StaticResource Text.Body}" Margin="0,1"
                           Text="•  The workbook must come from this project. Workbooks from another project are blocked." />
                <TextBlock Style="{StaticResource Text.Body}" Margin="0,1"
                           Text="•  Each value is compared three ways: exported value, current Revit value and Excel value." />
                <Button Content="Choose workbook…" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left"
                        Margin="0,14,0,0" Command="{Binding ChooseWorkbookCommand}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
