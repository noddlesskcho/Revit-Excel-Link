<UserControl x:Class="RevitScheduleSync.UI.Views.ModelSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- List-box selection bound to the item view model so several items can be moved at once. -->
            <Style x:Key="ParameterItem" TargetType="ListBoxItem">
                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                <Setter Property="Padding" Value="4,2" />
            </Style>

            <DataTemplate x:Key="ParameterTemplate">
                <Grid ToolTip="{Binding Detail}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="1" Margin="6,0,0,0" Padding="5,0" CornerRadius="3">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#E6F4EA" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ScopeText}" Value="Type">
                                        <Setter Property="Background" Value="#FFF1C2" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ScopeText}" Value="Read-only">
                                        <Setter Property="Background" Value="#FBDADA" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ScopeText}" FontSize="10" />
                    </Border>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Profile bar -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" Height="28" MinWidth="200"
                      VerticalContentAlignment="Center" Margin="0,0,14,0"
                      Visibility="{Binding HasSourceChoice, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Grid.Column="1" Text="{Binding SourceDescription}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBlock Text="Profile" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button Content="Load…" Style="{StaticResource Button.Secondary}" Command="{Binding LoadProfileCommand}"
                        ToolTip="Load saved categories and parameters (e.g. from a shared folder)" />
                <Button Content="Save…" Margin="6,0,0,0" Style="{StaticResource Button.Secondary}" Command="{Binding SaveProfileCommand}"
                        ToolTip="Save these categories and parameters as a profile" />
            </StackPanel>
        </Grid>

        <!-- Options -->
        <Grid Grid.Row="1" Margin="0,10,0,10">
            <WrapPanel VerticalAlignment="Center">
                <CheckBox Content="Active view only" Margin="0,0,14,0" VerticalAlignment="Center"
                          IsChecked="{Binding UseActiveView}" IsEnabled="{Binding HasActiveView}"
                          Visibility="{Binding ShowsScope, Converter={StaticResource BoolToVisibility}}" />
                <CheckBox Content="Include linked models (read-only)" Margin="0,0,14,0" VerticalAlignment="Center"
                          IsChecked="{Binding IncludeLinked}"
                          Visibility="{Binding ShowsLinked, Converter={StaticResource BoolToVisibility}}" />
                <CheckBox Content="One row per type" Margin="0,0,14,0" VerticalAlignment="Center"
                          IsChecked="{Binding ExportByType}"
                          ToolTip="Export element types instead of instances (type parameters only)."
                          Visibility="{Binding ShowsByType, Converter={StaticResource BoolToVisibility}}" />
                <CheckBox Content="Empty template (columns only)" VerticalAlignment="Center"
                          IsChecked="{Binding EmptyTemplate}"
                          ToolTip="Export no rows: type new rows in Excel to create rooms or spaces."
                          Visibility="{Binding ShowsTemplate, Converter={StaticResource BoolToVisibility}}" />
            </WrapPanel>
        </Grid>

        <!-- Categories | Available parameters | Selected parameters -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Categories -->
            <DockPanel Visibility="{Binding ShowsCategories, Converter={StaticResource BoolToVisibility}}">
                <TextBlock DockPanel.Dock="Top" Text="Categories" Style="{StaticResource Text.Heading}" Margin="0,0,0,6" />
                <TextBox DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Margin="0,0,0,6"
                         Text="{Binding CategorySearch, UpdateSourceTrigger=PropertyChanged, Delay=150}" ToolTip="Search categories" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Select all" Style="{StaticResource Button.Secondary}" Command="{Binding SelectAllCategoriesCommand}" />
                    <Button Content="Clear" Margin="6,0,0,0" Style="{StaticResource Button.Secondary}" Command="{Binding ClearCategoriesCommand}" />
                </StackPanel>
                <Border Style="{StaticResource Card}" Padding="0">
                    <ListBox ItemsSource="{Binding CategoriesView}" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Text}" IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>

            <!-- Available parameters -->
            <DockPanel Grid.Column="2" Visibility="{Binding ShowsParameters, Converter={StaticResource BoolToVisibility}}">
                <TextBlock DockPanel.Dock="Top" Text="Available parameters" Style="{StaticResource Text.Heading}" Margin="0,0,0,6" />
                <TextBox DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Margin="0,0,0,6"
                         Text="{Binding ParameterSearch, UpdateSourceTrigger=PropertyChanged, Delay=150}" ToolTip="Search parameters" />
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <CheckBox Content="Instance" IsChecked="{Binding ShowInstance}" Margin="0,0,10,0" />
                    <CheckBox Content="Type" IsChecked="{Binding ShowType}" Margin="0,0,10,0" />
                    <CheckBox Content="Read-only" IsChecked="{Binding ShowReadOnly}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding ParameterSummary}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0" />
                <Border Style="{StaticResource Card}" Padding="0">
                    <ListBox ItemsSource="{Binding AvailableView}" SelectionMode="Extended" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ItemContainerStyle="{StaticResource ParameterItem}" ItemTemplate="{StaticResource ParameterTemplate}" />
                </Border>
            </DockPanel>

            <!-- Move buttons -->
            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="8,0"
                        Visibility="{Binding ShowsParameters, Converter={StaticResource BoolToVisibility}}">
                <Button Content="&#x203A;" ToolTip="Add selected" Style="{StaticResource Button.Secondary}" Command="{Binding AddCommand}" Margin="0,0,0,4" />
                <Button Content="&#x00BB;" ToolTip="Add all shown" Style="{StaticResource Button.Secondary}" Command="{Binding AddAllCommand}" Margin="0,0,0,12" />
                <Button Content="&#x2039;" ToolTip="Remove selected" Style="{StaticResource Button.Secondary}" Command="{Binding RemoveCommand}" Margin="0,0,0,4" />
                <Button Content="&#x00AB;" ToolTip="Remove all" Style="{StaticResource Button.Secondary}" Command="{Binding RemoveAllCommand}" />
            </StackPanel>

            <!-- Selected parameters -->
            <DockPanel Grid.Column="4" Visibility="{Binding ShowsParameters, Converter={StaticResource BoolToVisibility}}">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="Selected parameters (column order)" Style="{StaticResource Text.Heading}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="&#x25B2;" ToolTip="Move up" Style="{StaticResource Button.Link}" Command="{Binding MoveUpCommand}" />
                        <Button Content="&#x25BC;" ToolTip="Move down" Margin="6,0,0,0" Style="{StaticResource Button.Link}" Command="{Binding MoveDownCommand}" />
                    </StackPanel>
                </Grid>
                <Border Style="{StaticResource Card}" Padding="0">
                    <ListBox ItemsSource="{Binding Selected}" SelectionMode="Extended" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ItemContainerStyle="{StaticResource ParameterItem}" ItemTemplate="{StaticResource ParameterTemplate}" />
                </Border>
            </DockPanel>
        </Grid>

        <!-- Action bar: reset | summary | import, export -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="Reset" Style="{StaticResource Button.Secondary}" Command="{Binding ResetCommand}"
                    ToolTip="Clear categories, parameters and options on this tab" />
            <TextBlock Grid.Column="1" Text="{Binding CategorySummary}" Style="{StaticResource Text.Body}" VerticalAlignment="Center"
                       Margin="12,0" TextTrimming="CharacterEllipsis"
                       Visibility="{Binding ShowsCategories, Converter={StaticResource BoolToVisibility}}" />
            <Button Grid.Column="2" Content="Import from Excel…" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"
                    Command="{Binding ImportCommand}" ToolTip="Open the Import tab to bring an edited workbook back" />
            <Button Grid.Column="3" Content="Export to Excel ›" Style="{StaticResource Button.Primary}"
                    Command="{Binding ExportCommand}" ToolTipService.ShowOnDisabled="True"
                    ToolTip="Choose where to save the workbook" />
        </Grid>
    </Grid>
</UserControl>
