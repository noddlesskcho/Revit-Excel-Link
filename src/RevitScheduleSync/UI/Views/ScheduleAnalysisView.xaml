<UserControl x:Class="RevitScheduleSync.UI.Views.ScheduleAnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Theme merged locally: see ScheduleSelectionView.xaml for why. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title + step indicator -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Analyse fields" Style="{StaticResource Text.Title}" />
                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,2,0,0">
                <Border Style="{StaticResource StepPill.Done}">
                    <TextBlock Text="&#x2713;  Select" FontSize="12" />
                </Border>
                <TextBlock Text="&#x203A;" Margin="6,0" FontSize="16" VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.TextMuted}" />
                <Border Style="{StaticResource StepPill.Current}">
                    <TextBlock Text="2  Analyse" FontSize="12" />
                </Border>
                <TextBlock Text="&#x203A;" Margin="6,0" FontSize="16" VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.TextMuted}" />
                <Border Style="{StaticResource StepPill.Upcoming}">
                    <TextBlock Text="3  Export" FontSize="12" />
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Analysed schedules -->
            <ListBox ItemsSource="{Binding Schedules}" SelectedItem="{Binding SelectedSchedule}"
                     BorderBrush="{StaticResource Brush.Border}" Background="{StaticResource Brush.Surface}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                            <Border Style="{StaticResource SupportBadge}" Margin="0,4,0,0">
                                <TextBlock Text="{Binding LayoutText}" FontSize="11" />
                            </Border>
                            <TextBlock Text="{Binding CountsText}" FontSize="11" Margin="0,4,0,0"
                                       Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Fields of the selected schedule -->
            <Grid Grid.Column="2" DataContext="{Binding SelectedSchedule}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Heading}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="1" Text="{Binding SampleText}" Style="{StaticResource Text.Muted}" Margin="0,2,0,8" />

                <StackPanel Grid.Row="2">
                    <Border Style="{StaticResource NoteBox}" Margin="0,0,0,8"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Error}" Style="{StaticResource Text.Body}" />
                    </Border>
                    <Border Style="{StaticResource NoteBox}" Margin="0,0,0,8"
                            Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Notes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource Text.Body}" Margin="0,1">
                                        <Run Text="•  " /><Run Text="{Binding Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <DataGrid Grid.Row="3" ItemsSource="{Binding Fields}"
                          Style="{StaticResource Grid.Flat}"
                          ColumnHeaderStyle="{StaticResource Grid.Header}"
                          CellStyle="{StaticResource Grid.Cell}">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <!-- Hover a row for the technical identity (parameter key, GUID, spec, unit). -->
                            <Setter Property="ToolTip" Value="{Binding DetailText}" />
                            <Setter Property="ToolTipService.InitialShowDelay" Value="600" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="34" />
                        <DataGridTextColumn Header="Column heading" Binding="{Binding Heading}" Width="*" MinWidth="120" />
                        <DataGridTextColumn Header="Parameter" Binding="{Binding ParameterName}" Width="*" MinWidth="120" />
                        <DataGridTextColumn Header="Source" Binding="{Binding SourceText}" Width="Auto" MinWidth="64" />
                        <DataGridTextColumn Header="Scope" Binding="{Binding ScopeText}" Width="Auto" MinWidth="64" />
                        <DataGridTextColumn Header="Storage" Binding="{Binding StorageText}" Width="Auto" MinWidth="80" />
                        <DataGridTextColumn Header="Value type" Binding="{Binding ValueTypeText}" Width="1.3*" MinWidth="130" />
                        <DataGridTemplateColumn Header="Sync" SortMemberPath="Classification" Width="Auto" MinWidth="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource FieldBadge}" ToolTip="{Binding Reason}">
                                        <TextBlock Text="{Binding ClassificationText}" FontSize="11" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Notes" Binding="{Binding FlagsText}" Width="*" MinWidth="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <!-- Navigation -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="‹ Back" Style="{StaticResource Button.Secondary}" Command="{Binding BackCommand}" />
            <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Style="{StaticResource Text.Muted}"
                       Text="Hover a field row for its parameter identity. Nothing has been written to the model." />
            <Button Grid.Column="2" Content="Export ›" Style="{StaticResource Button.Primary}"
                    Command="{Binding ExportCommand}"
                    ToolTipService.ShowOnDisabled="True"
                    ToolTip="Excel export arrives in Phase 3." />
        </Grid>
    </Grid>
</UserControl>
