<Window x:Class="RevitScheduleSync.UI.Views.ScheduleSyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RevitScheduleSync.UI.ViewModels"
        xmlns:views="clr-namespace:RevitScheduleSync.UI.Views"
        Title="Schedule Sync"
        Width="1100" Height="700" MinWidth="820" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Relative URI: resolved against this assembly, independent of the add-in load context. -->
                <ResourceDictionary Source="../Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:ExportViewModel}">
                <ContentControl Content="{Binding CurrentStep}" />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ScheduleSelectionViewModel}">
                <views:ScheduleSelectionView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ScheduleAnalysisViewModel}">
                <views:ScheduleAnalysisView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ExportResultViewModel}">
                <views:ExportResultView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ImportViewModel}">
                <ContentControl Content="{Binding CurrentStep}" />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ImportStartViewModel}">
                <views:ImportStartView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ChangeReviewViewModel}">
                <views:ChangeReviewView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ImportReportViewModel}">
                <views:ImportReportView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
                <views:HistoryView />
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource Brush.Window}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: product, active document, navigation -->
        <Border Grid.Row="0" Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="20,14,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Schedule Sync" Style="{StaticResource Text.Title}" />

                <StackPanel Grid.Column="1" HorizontalAlignment="Right" MaxWidth="460">
                    <TextBlock Text="{Binding Session.DocumentTitle}" Style="{StaticResource Text.Heading}"
                               TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource Text.Muted}" TextAlignment="Right"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               ToolTip="{Binding Session.DocumentLocation}">
                        <Run Text="{Binding WorksharingText, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding Session.DocumentLocation, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <ListBox Grid.Row="1" Grid.ColumnSpan="2" Margin="-14,10,0,0"
                         ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection}"
                         ItemContainerStyle="{StaticResource NavItem}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Active section. No outer ScrollViewer: it would disable DataGrid row virtualization. -->
        <ContentControl Grid.Row="1" Content="{Binding SelectedSection}" Margin="20,16,20,16" />

        <!-- Footer: diagnostics and close -->
        <Border Grid.Row="2" Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Style="{StaticResource Text.Muted}" VerticalAlignment="Center" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis">
                    <Run Text="Plugin" />
                    <Run Text="{Binding Session.PluginVersion, Mode=OneWay}" />
                    <Run Text=" · Revit" />
                    <Run Text="{Binding Session.RevitVersion, Mode=OneWay}" />
                    <Run Text=" · .NET" />
                    <Run Text="{Binding Session.RuntimeVersion, Mode=OneWay}" />
                    <Run Text=" · ClosedXML" />
                    <Run Text="{Binding Session.ExcelLibraryVersion, Mode=OneWay}" />
                </TextBlock>

                <Button Grid.Column="1" Content="Open log folder" Margin="12,0"
                        Style="{StaticResource Button.Link}"
                        Command="{Binding OpenLogFolderCommand}" />

                <Button Grid.Column="2" Content="Close" IsCancel="True"
                        Style="{StaticResource Button.Secondary}"
                        Command="{Binding CloseCommand}" />
            </Grid>
        </Border>
    </Grid>
</Window>
